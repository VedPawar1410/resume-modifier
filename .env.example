# Required: Claude API key — https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional: Claude model for resume generation (default: claude-haiku-5-5)
# KB_MODEL=claude-sonnet-5-5

# Optional: path to your knowledge base (default: ../resume-knowledge-base/kb.md)
# KB_PATH=/absolute/path/to/kb.md

# Optional fallbacks, tried in order if Claude fails
GROQ_API_KEY=
OPENROUTER_API_KEY=
