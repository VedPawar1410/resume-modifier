# Required: Claude API key — https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional: Claude model for resume generation (default: claude-haiku-5-5)
# KB_MODEL=claude-sonnet-5-5

# Optional: path to your knowledge base (default: ../resume-knowledge-base/kb.md)
# KB_PATH=/absolute/path/to/kb.md

# Optional fallbacks, tried in order if Claude fails
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Deployment only (see docs/DEPLOYMENT.md) — leave unset for local use ──────
# KB_GITHUB_REPO=VedPawar1410/resume-knowledge-base   # read kb.md from GitHub instead of KB_PATH
# GITHUB_TOKEN=                                        # fine-grained, read-only on that repo
# DATABASE_URL=                                        # Neon Postgres (direct connection string)
# APP_PASSWORD=                                        # turns on the password screen
# AUTH_SECRET=                                         # signs login tokens
# CORS_ORIGINS=https://your-app.vercel.app             # the deployed frontend
